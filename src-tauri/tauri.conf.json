{
  "$schema": "../node_modules/@tauri-apps/cli/schema/v2/tauri-config-0.1.0.json",
  "productName": "AiMitra",
  "version": "0.1.0",
  "identifier": "com.aimitra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "shell": {
      "all": false,
      "open": true,
      "command": false
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA/aimitra/**", "$APPDATA/aimitra/models/**"]
    },
    "dialog": {
      "all": true,
      "open": true,
      "save": true
    },
    "process": {
      "all": true
    },
    "os": {
      "all": true
    },
    "clipboard": {
      "all": true
    },
    "notification": {
      "all": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}